{
    "name": "unipo/siakad-sdk",
    "description": "SDK resmi API SIAKAD UNIPO untuk PHP 8.1+: token OAuth2 otomatis, 2.000+ endpoint bertipe, PSR-18, integrasi Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "siakad",
        "unipo",
        "api",
        "sdk",
        "oauth2",
        "laravel",
        "psr-18",
        "akademik"
    ],
    "homepage": "https://github.com/anasamu/unipo-sdk",
    "support": {
        "issues": "https://github.com/anasamu/unipo-sdk/issues",
        "source": "https://github.com/anasamu/unipo-sdk",
        "docs": "https://api.unipo.ac.id/docs/panduan/sdk"
    },
    "authors": [
        {
            "name": "Pustikom Universitas Pohuwato",
            "homepage": "https://pustikom.unipo.ac.id"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "guzzlehttp/psr7": "^2.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.12"
    },
    "suggest": {
        "laravel/framework": "Service provider, facade Siakad, dan cache token otomatis (^10, ^11, ^12)"
    },
    "autoload": {
        "psr-4": {
            "Unipo\\Siakad\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Unipo\\Siakad\\Tests\\": "php/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Unipo\\Siakad\\Laravel\\SiakadServiceProvider"
            ],
            "aliases": {
                "Siakad": "Unipo\\Siakad\\Laravel\\Facades\\Siakad"
            }
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
